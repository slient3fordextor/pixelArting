ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE} AS builder
WORKDIR /build
COPY deploy/requirements-mcp.lock /build/requirements-mcp.lock
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --require-hashes -r requirements-mcp.lock
COPY pyproject.toml README.md LICENSE /build/
COPY backend /build/backend
RUN /opt/venv/bin/pip install --no-cache-dir --no-deps /build

FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.title="PixelArting MCP" \
      org.opencontainers.image.description="Standalone PixelArting MCP workspace service" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIXELART_DATA_DIR=/data \
    HOME=/tmp
COPY --from=builder /opt/venv /opt/venv
RUN mkdir /data && chown 65532:65532 /data
USER 65532:65532
WORKDIR /data
ENTRYPOINT ["pixelarting-mcp"]
CMD ["--read-only"]
